# Plantilla de .env para desarrollo local. .env está en .gitignore.
# scripts/dev-keys.sh crea .env a partir de este fichero con una contraseña aleatoria.
# Nunca reutilizar estos valores fuera de la máquina local.

# PostgreSQL de docker compose. La aplicación con el perfil local lee las mismas variables.
# La contraseña se fija al crear el volumen: si cambia después, docker compose down -v (borra los datos locales)
POSTGRES_DB=opswatch
POSTGRES_USER=opswatch
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
